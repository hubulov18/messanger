generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("PROFILE_DATABASE_URL")
}

enum VisibilityLevel {
  everyone
  contacts
  nobody
}

enum OutboxEventStatus {
  pending
  published
  failed
}

model UserProfile {
  userId                 String          @id @map("user_id")
  username               String          @unique
  displayName            String          @map("display_name")
  bio                    String?
  avatarMediaId          String?         @map("avatar_media_id")
  lastSeenVisibility     VisibilityLevel @default(contacts) @map("last_seen_visibility")
  phoneVisibility        VisibilityLevel @default(nobody) @map("phone_visibility")
  profilePhotoVisibility VisibilityLevel @default(everyone) @map("profile_photo_visibility")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  @@index([displayName])
  @@map("user_profiles")
}

model BlockRelation {
  id            String   @id
  ownerUserId   String   @map("owner_user_id")
  blockedUserId String   @map("blocked_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([ownerUserId, blockedUserId])
  @@index([blockedUserId])
  @@map("block_relations")
}

model OutboxEvent {
  id           String            @id
  eventType    String            @map("event_type")
  eventVersion Int               @map("event_version")
  aggregateId  String            @map("aggregate_id")
  partitionKey String            @map("partition_key")
  payloadJson  Json              @map("payload_json")
  occurredAt   DateTime          @map("occurred_at")
  publishedAt  DateTime?         @map("published_at")
  status       OutboxEventStatus
  attemptCount Int               @default(0) @map("attempt_count")
  lastError    String?           @map("last_error")
  lockedAt     DateTime?         @map("locked_at")
  lockedBy     String?           @map("locked_by")

  @@index([status, lockedAt, occurredAt])
  @@index([lockedBy])
  @@map("outbox_events")
}
