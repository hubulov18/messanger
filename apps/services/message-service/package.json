{
  "name": "@telegram/message-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build && node ../../../scripts/build/copy-prisma-generated.mjs .",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --loader ./src/test-loader.mjs --test 'src/**/*.spec.ts'",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format"
  },
  "dependencies": {
    "@telegram/contracts": "0.1.0",
    "@telegram/shared": "0.1.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.14.1",
    "prisma": "^6.6.0"
  }
}
