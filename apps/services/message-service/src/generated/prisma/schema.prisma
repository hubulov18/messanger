generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("MESSAGE_DATABASE_URL")
}

enum MessageType {
  text
  image
  video
  audio
  file
  system
}

enum MessageStatus {
  sent
  edited
  deleted
}

enum OutboxEventStatus {
  pending
  published
  failed
}

model Message {
  id                     String              @id
  chatId                 String              @map("chat_id")
  senderUserId           String              @map("sender_user_id")
  clientMessageId        String              @map("client_message_id")
  type                   MessageType
  text                   String?
  replyToMessageId       String?             @map("reply_to_message_id")
  forwardedFromMessageId String?             @map("forwarded_from_message_id")
  createdAt              DateTime            @default(now()) @map("created_at")
  editedAt               DateTime?           @map("edited_at")
  deletedAt              DateTime?           @map("deleted_at")
  status                 MessageStatus       @default(sent)
  attachments            MessageAttachment[]
  reactions              MessageReaction[]
  revisions              MessageRevision[]

  @@unique([chatId, clientMessageId])
  @@index([chatId, createdAt(sort: Desc)])
  @@index([senderUserId])
  @@index([replyToMessageId])
  @@map("messages")
}

model MessageAttachment {
  id             String   @id
  messageId      String   @map("message_id")
  mediaId        String   @map("media_id")
  attachmentType String   @map("attachment_type")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  message        Message  @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id])

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageRevision {
  id             String   @id
  messageId      String   @map("message_id")
  previousText   String?  @map("previous_text")
  editedByUserId String   @map("edited_by_user_id")
  editedAt       DateTime @map("edited_at")
  message        Message  @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@map("message_revisions")
}

model ReadReceipt {
  id                String   @id
  chatId            String   @map("chat_id")
  userId            String   @map("user_id")
  lastReadMessageId String   @map("last_read_message_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([chatId, userId])
  @@index([userId])
  @@map("read_receipts")
}

model DeliveryReceipt {
  id                     String   @id
  chatId                 String   @map("chat_id")
  userId                 String   @map("user_id")
  lastDeliveredMessageId String   @map("last_delivered_message_id")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([chatId, userId])
  @@map("delivery_receipts")
}

model ChatMessageCounter {
  chatId        String   @map("chat_id")
  userId        String   @map("user_id")
  lastMessageId String?  @map("last_message_id")
  unreadCount   Int      @default(0) @map("unread_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@id([chatId, userId])
  @@index([userId])
  @@map("chat_message_counters")
}

model ChatSummaryProjection {
  chatId             String    @id @map("chat_id")
  lastMessageId      String?   @map("last_message_id")
  lastMessagePreview String?   @map("last_message_preview")
  lastActivityAt     DateTime? @map("last_activity_at")
  lastSenderUserId   String?   @map("last_sender_user_id")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([lastActivityAt(sort: Desc)])
  @@map("chat_summary_projection")
}

model ChatSummaryProjectionEvent {
  eventId    String   @id @map("event_id")
  eventType  String   @map("event_type")
  occurredAt DateTime @map("occurred_at")
  chatId     String?  @map("chat_id")

  @@index([occurredAt])
  @@index([chatId, occurredAt])
  @@map("chat_summary_projection_events")
}

model ChatSummaryProjectionOffset {
  consumer       String    @id
  lastEventId    String?   @map("last_event_id")
  lastOccurredAt DateTime? @map("last_occurred_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("chat_summary_projection_offsets")
}

model OutboxEvent {
  id           String            @id
  eventType    String            @map("event_type")
  eventVersion Int               @map("event_version")
  aggregateId  String            @map("aggregate_id")
  partitionKey String            @map("partition_key")
  payloadJson  Json              @map("payload_json")
  occurredAt   DateTime          @map("occurred_at")
  publishedAt  DateTime?         @map("published_at")
  status       OutboxEventStatus
  attemptCount Int               @default(0) @map("attempt_count")
  lastError    String?           @map("last_error")
  lockedAt     DateTime?         @map("locked_at")
  lockedBy     String?           @map("locked_by")

  @@index([status, lockedAt, occurredAt])
  @@index([lockedBy])
  @@map("outbox_events")
}
