PORT=3003
MESSAGE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_message
CHAT_SERVICE_URL=http://localhost:3002
PROFILE_SERVICE_URL=http://localhost:3004
JWT_ACCESS_SECRET=replace-with-long-random-secret
