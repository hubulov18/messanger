<?xml version="1.0" encoding="utf-8"?>
<!--
    Release/default network security policy.

    Cleartext HTTP stays disabled here so production-style builds do not
    accidentally talk to insecure endpoints.
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
