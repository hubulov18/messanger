{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["ES2022"],
    "types": ["react", "react-native"],
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    "rootDir": "./src",
    "baseUrl": "./src"
  },
  "include": ["src/**/*"]
}
