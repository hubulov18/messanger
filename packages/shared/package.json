{
  "name": "@telegram/shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contacts": {
      "types": "./dist/contacts/index.d.ts",
      "default": "./dist/contacts/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./outbox": {
      "types": "./dist/outbox/index.d.ts",
      "default": "./dist/outbox/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --loader ./src/test-loader.mjs --test 'src/**/*.spec.ts'"
  },
  "dependencies": {
    "amqplib": "^0.10.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7"
  }
}
